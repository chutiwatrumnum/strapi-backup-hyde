{
  "kind": "collectionType",
  "collectionName": "occupation_histories",
  "info": {
    "name": "occupation_history"
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "time": {
      "type": "time",
      "default": "00:00:00"
    },
    "day": {
      "type": "enumeration",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "required": true
    },
    "in_count": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "required": true
    },
    "out_count": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "required": true
    }
  }
}
