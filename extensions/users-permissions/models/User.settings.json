    "gi_uid": {
      "type": "string"
    },
    "gi_sip": {
      "type": "string"
    },
    "inhabitant": {
      "via": "inhabitants",
      "model": "addresses"
    },
    "tenant": {
      "via": "tenants",
      "model": "addresses"
    },
